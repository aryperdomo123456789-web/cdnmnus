[Unit]
Description=cdnmnus Ansible deployment worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cdn-admin
Group=cdn-admin
WorkingDirectory=/opt/cdnmnus
EnvironmentFile=/etc/cdnmnus/admin.env
Environment="CDNMNUS_ADMIN_DB=/var/lib/cdnmnus-admin/admin.db"
Environment="PYTHONPATH=/opt/cdnmnus"
Environment="PATH=/opt/cdnmnus/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="ANSIBLE_CONFIG=/opt/cdnmnus/ansible/ansible.cfg"
ExecStart=/opt/cdnmnus/venv/bin/python3 /opt/cdnmnus/orchestrator/worker.py
Restart=on-failure
RestartSec=3
# The TLS helper is the only sudoers-authorized root operation for this user.
# NoNewPrivileges would prevent sudo from entering that constrained path.
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cdnmnus-admin /etc/cdnmnus/ssh /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt
# The worker uses the narrowly allowlisted ACME helper through sudo. Keeping
# this restriction enabled implicitly sets NoNewPrivileges on some systemd
# versions and prevents that single, audited elevation path.
RestrictSUIDSGID=false
LockPersonality=true
RestrictRealtime=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
