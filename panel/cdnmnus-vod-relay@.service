[Unit]
Description=cdnmnus private VOD relay for tenant %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=CDNMNUS_TENANT_ID=%i
Environment=CDNMNUS_TENANTS_CONFIG=/opt/cdnmnus/current/broker/tenants.json
Environment=CDNMNUS_VOD_RELAY_SOCKET=/run/cdnmnus/vod-relay-%i.sock
ExecStart=/usr/bin/python3 /opt/cdnmnus/current/runtime/vod_relay.py
RuntimeDirectory=cdnmnus
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/cdnmnus/current
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
TasksMax=512
MemoryMax=512M
UMask=0077

[Install]
WantedBy=multi-user.target
